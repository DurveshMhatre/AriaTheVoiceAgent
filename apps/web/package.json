{
  "name": "aria-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node -r ./load-root-env.cjs ./node_modules/next/dist/bin/next dev",
    "build": "node -r ./load-root-env.cjs ./node_modules/next/dist/bin/next build",
    "start": "node -r ./load-root-env.cjs ./node_modules/next/dist/bin/next start",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src middleware.ts next.config.ts vitest.config.ts check_bundle_secrets.mjs",
    "check:bundle-secrets": "node check_bundle_secrets.mjs"
  },
  "dependencies": {
    "@livekit/protocol": "1.51.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "22.19.3",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.26",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@vitest/coverage-v8": "4.0.5",
    "ajv": "8.17.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vitest": "4.0.5"
  }
}
