#!/bin/sh
set -eu
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/secret_scan.ps1
else
  echo 'Install gitleaks or run scripts/secret_scan.ps1 on Windows.' >&2
  exit 1
fi
