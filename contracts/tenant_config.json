{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.example/contracts/tenant_config.json",
  "title": "Tenant Configuration",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "brand", "persona", "knowledge", "policies", "enabled_tools", "voice", "language", "caps", "providers"],
  "properties": {
    "schema_version": { "const": 1 },
    "tenant_id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "brand": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "description", "support_email", "support_phone", "support_url", "contact_verified"],
      "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "support_email": { "const": "PLACEHOLDER" }, "support_phone": { "const": "PLACEHOLDER" }, "support_url": { "const": "PLACEHOLDER" }, "contact_verified": { "const": false } }
    },
    "persona": { "type": "object", "additionalProperties": false, "required": ["name", "role", "style"], "properties": { "name": { "type": "string" }, "role": { "type": "string" }, "style": { "type": "string" } } },
    "knowledge": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["topic", "content"], "properties": { "topic": { "type": "string" }, "content": { "type": "string" } } } },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["free_shipping_threshold_inr", "free_shipping_rule", "shipping_fee_inr", "standard_delivery_business_days", "return_window_days", "damage_report_window_hours", "cod_limit_inr", "cod_limit_inclusive", "cancellable_status", "id_format"],
      "properties": { "free_shipping_threshold_inr": { "type": "integer", "minimum": 0 }, "free_shipping_rule": { "enum": ["above", "at_or_above"] }, "shipping_fee_inr": { "type": "integer", "minimum": 0 }, "standard_delivery_business_days": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } }, "return_window_days": { "type": "integer", "minimum": 0 }, "damage_report_window_hours": { "type": "integer", "minimum": 0 }, "cod_limit_inr": { "type": "integer", "minimum": 0 }, "cod_limit_inclusive": { "type": "boolean" }, "cancellable_status": { "type": "string" }, "id_format": { "type": "string", "minLength": 1 } }
    },
    "enabled_tools": { "type": "array", "items": { "type": "string", "enum": ["get_order_details", "check_return_eligibility", "cancel_order", "escalate_to_human"] } },
    "voice": { "type": "object", "additionalProperties": false, "required": ["default_voice_mode", "provider", "model", "speaker"], "properties": { "default_voice_mode": { "enum": ["mock", "real"] }, "provider": { "type": "string" }, "model": { "type": "string" }, "speaker": { "type": "string" } } },
    "language": { "type": "object", "additionalProperties": false, "required": ["default", "allowed"], "properties": { "default": { "type": "string" }, "allowed": { "type": "array", "items": { "type": "string" } } } },
    "caps": { "type": "object", "additionalProperties": false, "required": ["max_call_duration_seconds", "idle_timeout_seconds", "max_concurrent_calls", "per_user_daily_calls"], "properties": { "max_call_duration_seconds": { "type": "integer", "minimum": 1 }, "idle_timeout_seconds": { "type": "integer", "minimum": 1 }, "max_concurrent_calls": { "type": "integer", "minimum": 1 }, "per_user_daily_calls": { "type": "integer", "minimum": 1 } } },
    "providers": { "$ref": "#/$defs/providers" }
  },
  "$defs": {
    "chain": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["provider", "model"], "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "enabled": { "type": "boolean" } } } },
    "providers": { "type": "object", "additionalProperties": false, "required": ["stt", "llm", "tts"], "properties": { "stt": { "$ref": "#/$defs/chain" }, "llm": { "type": "object", "additionalProperties": false, "required": ["model_candidates", "chain"], "properties": { "model_candidates": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" } }, "chain": { "$ref": "#/$defs/chain" } } }, "tts": { "$ref": "#/$defs/chain" } } }
  }
}
