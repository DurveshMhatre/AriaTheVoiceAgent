{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aura.example/contracts/client_message.json",
  "title": "Client to agent message",
  "oneOf": [
    { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "text_input" }, "text": { "type": "string", "minLength": 1, "maxLength": 2000 } } },
    { "type": "object", "additionalProperties": false, "required": ["type"], "properties": { "type": { "const": "end_call" } } }
  ]
}
